{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 예약 실행 전용(공개 주소 없음): 매일 03:17, 15:17 UTC 에 Supabase 를 깨워 둔다.
  "name": "marathoncalendar-cron",
  "main": "worker/cron.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["17 3,15 * * *"] },
  "vars": {
    "SUPABASE_URL": "https://zhwmfvkwtmakieatlqtz.supabase.co",
    "SUPABASE_KEY": "sb_publishable_uOBwP5-BbK7keBuq3gsMAg_Oil1yg6O"
  }
}
