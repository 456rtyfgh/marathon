{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marathon",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 공유 링크(/r/대회id), 캘린더 파일(/cal/…), /__ping 만 워커가 받는다. 첫 화면·data.json 은 워커 없이 바로 나간다(무료 한도 보호).
    "run_worker_first": ["/r/*", "/cal/*", "/__ping"]
  },
  // 매일 03:17, 15:17 UTC 에 Supabase 를 깨워 둔다 (heartbeat 한 줄 기록)
  "triggers": { "crons": ["17 3,15 * * *"] },
  "vars": {
    "SUPABASE_URL": "https://zhwmfvkwtmakieatlqtz.supabase.co",
    "SUPABASE_KEY": "sb_publishable_uOBwP5-BbK7keBuq3gsMAg_Oil1yg6O"
  }
}
