{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 예전 주소(marathon.junubenchoi.workers.dev) 담당: 새 주소로 301 이동만 한다.
  // 사이트 본체는 Cloudflare Pages(marathon82.com), DB 깨우기는 wrangler.cron.jsonc 워커.
  "name": "marathon",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "triggers": { "crons": [] },
  "vars": { "SITE_ORIGIN": "https://marathon82.com" }
}
