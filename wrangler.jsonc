{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marathon",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 공유 링크(/?r=...)에 대회별 미리보기 태그를 넣으려고 "/" 만 워커가 먼저 받는다
    "run_worker_first": ["/"]
  },
  // 이틀마다 03:17 UTC 에 Supabase 를 깨워 둔다
  "triggers": { "crons": ["17 3 */2 * *"] },
  "vars": {
    "SUPABASE_URL": "https://zhwmfvkwtmakieatlqtz.supabase.co",
    "SUPABASE_KEY": "sb_publishable_uOBwP5-BbK7keBuq3gsMAg_Oil1yg6O"
  }
}
