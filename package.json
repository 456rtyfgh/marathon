{
  "name": "runworld",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/seo-pages.mjs && node scripts/prerender.mjs && node scripts/sitemap.mjs && node scripts/rss.mjs && node scripts/pages.mjs && node scripts/terms.mjs && node scripts/evidence.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed:sql": "node scripts/gen-seed-sql.mjs",
    "db:push": "psql \"$SUPABASE_DB_URL\" -f supabase/migrations/0001_init.sql -f supabase/seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "data:json": "node scripts/gen-data-json.mjs",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wanted-sans": "^1.0.3"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "opentype.js": "^2.0.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.125.0"
  }
}
